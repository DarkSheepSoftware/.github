{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>DarkSheepSoftware/.github:renovate-config"
  ],
  "lockFileMaintenance": {
    "automerge": true
  },
  "packageRules": [
    {
      "matchUpdateTypes": [ "pin", "minor", "patch" ],
      "automerge": true
    },
    {
      "matchManagers": [ "github-actions" ],
      "automerge": true
    }
  ]
}
